# Archon Website — local development environment
# Copy this file to .env.local and add real values only where required.

# Sanity CMS (matches studio/archon-website-cms/sanity.config.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=iwbdc0fm
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-13

# Optional: show the Archon AI chat / guided tour UI (off by default until trained).
# NEXT_PUBLIC_ARCHON_AI_ENABLED=true

# Optional: enable a real Archon AI backend instead of the built-in development fallback.
# Do not commit a real key.
# ARCHON_AI_BACKEND_URL=https://your-secure-backend.example.com
# ARCHON_AI_API_KEY=replace_with_a_server_side_secret

# Website lead capture via Resend. Add real values only to .env.local and Vercel.
# The sender address must be verified in the Resend account before production use.
# RESEND_API_KEY=re_replace_with_private_resend_key
# RESEND_FROM_EMAIL=Archon Website <enquiries@archonsolution.in>
# LEAD_EMAIL_TO=info@archonsolution.com

# Supabase Postgres (project: archon-website)
# DATABASE_URL = pooled connection (app runtime)
# DIRECT_URL   = direct connection (Prisma migrate / db push)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace_with_anon_key"
# Required in production so admin photo/video uploads persist (Supabase Storage).
SUPABASE_SERVICE_ROLE_KEY="replace_with_service_role_key"

# Admin session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional overrides for db:seed
# ADMIN_EMAIL=admin@archonsolution.com
# ADMIN_PASSWORD=ChangeMe123!
