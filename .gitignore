# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files: keep real local values private, but track the safe template.
.env*
!.env.example

# Local SQLite database (legacy)
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal

# Temporary Supabase provisioning artifacts
.supabase-db-pass.tmp
.supabase-project.tmp.json
.admin-credentials.tmp
.render-service-id.tmp
.render-local-build.tmp
.render-log-snippet.tmp
.render-project.tmp.json

# Local probe / cookie / RSC debug artifacts
*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Nested Sanity Studio dependencies
studio/node_modules/

# Admin uploads (keep folder, ignore uploaded files)
/public/uploads/**
!/public/uploads/.gitkeep
